# Hybrid data layer — copy keys into .env.local (never commit secrets)

# Force DB mode (recommended once Postgres is connected)
DATA_SOURCE=db

# Postgres — Vercel Storage often sets POSTGRES_URL automatically.
# Any one of these works:
# DATABASE_URL=postgres://...
# POSTGRES_URL=postgres://...

# Optional: custom PGlite directory when no Postgres URL (default: ../.data/pglite)
# PGLITE_DATA_DIR=

# Vercel Blob — added when you connect a Blob store to the project
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Pull all of the above from Vercel (from repo root or web/):
#   npx vercel env pull web/.env.local
